# Plantilla de la firma de release (T-11).
#
# Se copia a `android/keystore.properties`, que está en `.gitignore`, y se
# rellena con los datos del almacén que custodie el banco. En un agente de
# compilación se usan en su lugar las variables de entorno BSC_KEYSTORE_FILE,
# BSC_KEYSTORE_PASSWORD, BSC_KEY_ALIAS y BSC_KEY_PASSWORD.
#
# La ruta es relativa a `android/` o absoluta. El archivo del almacén tampoco
# se versiona.

storeFile=../bsc-release.keystore
storePassword=
keyAlias=bsc
keyPassword=
