{
  "name": "bsc-unified-exp",
  "version": "0.1.0",
  "private": true,
  "description": "Banca móvil de Banco Santa Cruz — React Native",
  "license": "UNLICENSED",
  "scripts": {
    "android": "nx run BSC.genesis.mobile.banking:android",
    "ios": "nx run BSC.genesis.mobile.banking:ios",
    "start": "nx run BSC.genesis.mobile.banking:start",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"packages/**/src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"packages/**/src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:shared": "pnpm --filter @bsc/shared test",
    "test:coverage": "jest --coverage",
    "build:android": "react-native build-android --tasks assembleRelease",
    "verify": "node scripts/verify.mjs",
    "sbom": "node scripts/generar-sbom.mjs",
    "iconos": "node scripts/generar-iconos.mjs",
    "scan:secrets": "node scripts/escanear-secretos.mjs",
    "web": "vite",
    "web:build": "vite build"
  },
  "dependencies": {
    "@bsc/contracts": "workspace:*",
    "@bsc/design-system": "workspace:*",
    "@bsc/i18n": "workspace:*",
    "@bsc/shared": "workspace:*",
    "@bsc/utils": "workspace:*",
    "@react-native-async-storage/async-storage": "catalog:",
    "@react-native-clipboard/clipboard": "catalog:",
    "@react-native-vector-icons/common": "catalog:",
    "@react-native-vector-icons/feather": "catalog:",
    "@react-native-voice/voice": "catalog:",
    "@react-native/new-app-screen": "catalog:",
    "@react-navigation/bottom-tabs": "catalog:",
    "@react-navigation/native": "catalog:",
    "@react-navigation/native-stack": "catalog:",
    "axios": "catalog:",
    "crypto-js": "catalog:",
    "i18next": "catalog:",
    "jwt-decode": "catalog:",
    "react": "catalog:",
    "react-i18next": "catalog:",
    "react-native": "catalog:",
    "react-native-biometrics": "catalog:",
    "react-native-blob-util": "catalog:",
    "react-native-config": "catalog:",
    "react-native-device-info": "catalog:",
    "react-native-keychain": "catalog:",
    "react-native-linear-gradient": "catalog:",
    "react-native-passkey": "catalog:",
    "react-native-pdf": "catalog:",
    "react-native-safe-area-context": "catalog:",
    "react-native-screens": "catalog:",
    "react-native-svg": "catalog:",
    "react-native-tts": "catalog:",
    "react-native-video": "catalog:",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@babel/core": "catalog:",
    "@babel/preset-env": "catalog:",
    "@babel/runtime": "catalog:",
    "@react-native-community/cli": "catalog:",
    "@react-native-community/cli-platform-android": "catalog:",
    "@react-native-community/cli-platform-ios": "catalog:",
    "@react-native/assets-registry": "catalog:",
    "@react-native/babel-preset": "catalog:",
    "@react-native/codegen": "catalog:",
    "@react-native/eslint-config": "catalog:",
    "@react-native/gradle-plugin": "catalog:",
    "@react-native/jest-preset": "catalog:",
    "@react-native/metro-config": "catalog:",
    "@react-native/typescript-config": "catalog:",
    "@types/crypto-js": "catalog:",
    "@types/jest": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-test-renderer": "catalog:",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "babel-jest": "catalog:",
    "babel-plugin-module-resolver": "catalog:",
    "eslint": "catalog:",
    "hermes-compiler": "catalog:",
    "jest": "catalog:",
    "prettier": "catalog:",
    "react-dom": "catalog:",
    "react-native-web": "catalog:",
    "react-native-web-linear-gradient": "catalog:",
    "react-test-renderer": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "codegenConfig": {
    "name": "BscSecuritySpec",
    "type": "modules",
    "jsSrcsDir": "src/specs",
    "android": {
      "javaPackageName": "com.bsc.mobile.security"
    },
    "ios": {
      "modulesProvider": {
        "BiometricAuth": "BscBiometricAuthModule",
        "DeviceIntegrity": "BscDeviceIntegrityModule",
        "DeviceKey": "BscDeviceKeyModule",
        "SecureScreen": "BscSecureScreenModule",
        "SecureStorage": "BscSecureStorageModule",
        "StatementFile": "BscStatementFileModule"
      }
    }
  },
  "engines": {
    "node": ">= 22.11.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
