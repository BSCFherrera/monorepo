{
  // Base oficial de React Native, igual que mobile banking: resuelve los tipos de
  // `react-native` (moduleResolution "bundler" + condición "react-native") y trae
  // los globales del runtime (console, setTimeout, WebSocket). La configuración
  // anterior fijaba lib es2021 y moduleResolution node, y con eso tsc no
  // encontraba ninguno de los dos.
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": "./src",
    "paths": {
      "@components/*": ["components/*"],
      "@screens/*": ["screens/*"],
      "@services/*": ["services/*"],
      "@store/*": ["store/*"],
      "@utils/*": ["utils/*"],
      "@hooks/*": ["hooks/*"],
      "@/types/*": ["types/*"],
      "@constants/*": ["constants/*"],
      "@styles/*": ["styles/*"],
      "@i18n/*": ["i18n/*"],
      "@assets/*": ["../assets/*"]
    }
  },
  "include": ["src/**/*", "index.js"],
  "exclude": ["node_modules", "babel.config.js", "metro.config.js", "jest.config.js", "**/Pods/**"]
}
