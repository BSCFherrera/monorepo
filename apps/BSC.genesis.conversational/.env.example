# Copiar este archivo a .env y configurar según tu entorno

# WebSocket Server
# Front en la misma maquina
WEBSOCKET_URL=ws://localhost:8080/ws
# Alternativa local
# WEBSOCKET_URL=ws://localhost:8080/
# Emulador Android
# WEBSOCKET_URL=ws://10.0.2.2:8080/ws
# Celular u otra maquina en red
# WEBSOCKET_URL=ws://192.168.1.8:8080/ws

# API Configuration
API_BASE_URL=https://api.bancosantacruz.com
API_TIMEOUT=30000

# FIDO2 / Passkey
# URL base donde viven los endpoints de FIDO2 (/fido2/register/options, etc.)
FIDO_API_BASE_URL=https://api.bancosantacruz.com
# Dominio (sin esquema) usado en el App Link del AndroidManifest para la verificación de Passkeys
FIDO_APPLINK_HOST=api.bancosantacruz.com

# Autentikar (verificación de identidad: cédula + rostro)
# Alias de cuenta asignado por Autentikar. No es secreto.
# Las credenciales AWS (ACCESS_KEY/SECRET_KEY) del Maven privado van aparte en
# android/.env (ver android/.env.example) para que no terminen embebidas en el APK.
AUTENTIKAR_ALIAS=bancosantacruz

# Environment
NODE_ENV=development

# Android
ANDROID_HOME=C:\Users\TuUsuario\AppData\Local\Android\Sdk
JAVA_HOME=C:\Program Files\Java\jdk-17
