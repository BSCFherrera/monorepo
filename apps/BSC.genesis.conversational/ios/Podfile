# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

$create_native_vector_icons_fonts_backend = true

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'AppConversacionalBSC' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Fix: en este Clang, fmt sigue detectando soporte de consteval (__cpp_consteval)
    # incluso forzando C++17 via build settings (bug de deteccion del compilador).
    # En vez de pelear con flags que el compilador ignora, parcheamos el header de
    # fmt directamente para que FMT_CONSTEVAL nunca se defina como 'consteval'.
    # Se reaplica en cada 'pod install' porque Pods/ se regenera desde cero.
    fmt_base_header = File.join(installer.sandbox.pod_dir('fmt').to_s, 'include', 'fmt', 'base.h')
    if File.exist?(fmt_base_header)
      File.chmod(0644, fmt_base_header) # CocoaPods deja el source de fmt como solo-lectura
      contents = File.read(fmt_base_header)
      patched = contents.gsub(/#\s*define\s+FMT_CONSTEVAL\s+consteval/, '#  define FMT_CONSTEVAL')
      File.write(fmt_base_header, patched) if patched != contents
    end
  end
end
