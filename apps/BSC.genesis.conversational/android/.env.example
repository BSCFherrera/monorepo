# Copiar este archivo a android/.env y completar con las credenciales reales.
# Solicitar ACCESS_KEY/SECRET_KEY del Maven privado a Autentikar.
# Este archivo solo lo lee Gradle (android/build.gradle) para descargar el SDK en build-time;
# nunca se compila dentro del APK.
AUTENTIKAR_ACCESS_KEY=
AUTENTIKAR_SECRET_KEY=
