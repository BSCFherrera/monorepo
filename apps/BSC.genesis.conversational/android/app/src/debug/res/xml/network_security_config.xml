<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
  <!--
    Debug only: permite confiar el certificado del API directamente desde el recurso PEM.
    Esto aplica especialmente cuando la cadena TLS no es confiable en el emulador Android.
  -->
  <base-config cleartextTrafficPermitted="true">
    <trust-anchors>
      <certificates src="system" />
      <certificates src="user" />
    </trust-anchors>
  </base-config>

  <!--
    Este archivo REEMPLAZA al de src/main en builds debug, por lo que debe repetir la confianza
    en el CA interno de BSC; sin esto *.bsc.com.do (ej: apigateway-gen) falla con SSLHandshakeException.
  -->
  <domain-config>
    <domain includeSubdomains="true">bsc.com.do</domain>
    <trust-anchors>
      <certificates src="@raw/bsc_root_ca" />
      <certificates src="@raw/bsc_issuing_ca" />
      <certificates src="@raw/bsc_issuing_ca_orn" />
      <certificates src="system" />
    </trust-anchors>
  </domain-config>

  <domain-config cleartextTrafficPermitted="false">
    <domain includeSubdomains="false">api-genesis.dev.bsc.com.do</domain>
    <trust-anchors>
      <certificates src="@raw/api_cert" />
    </trust-anchors>
  </domain-config>
</network-security-config>
