# Shell scripts must keep LF line endings: a CRLF shebang (`#!/bin/sh\r`)
# fails on macOS and Linux. Windows batch files keep CRLF.
gradlew        text eol=lf
*.sh           text eol=lf
.xcode.env*    text eol=lf
*.bat          text eol=crlf
*.cmd          text eol=crlf

# Generated code is compared byte for byte against its generator, which writes LF.
libs/shared-design-tokens/src/generated/** text eol=lf

# Binary files: never touch their bytes.
*.jar          binary
*.keystore     binary
*.png          binary
*.jpg          binary
*.ttf          binary
docs/framework/metrics/events.jsonl merge=union
