{
  "name": "@bsc/i18n",
  "version": "0.0.0",
  "private": true,
  "description": "Sistema de traducción de las apps de BSC: i18next, idioma elegido y nombres del calendario.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "sideEffects": false,
  "dependencies": {
    "i18next": "^26.4.2",
    "react-i18next": "^17.0.15"
  },
  "peerDependencies": {
    "react": "19.2.3"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14"
  },
  "exports": {
    ".": "./src/index.ts",
    "./calendario": "./src/calendario.ts"
  },
  "typesVersions": {
    "*": {
      "calendario": [
        "src/calendario.ts"
      ]
    }
  }
}
