{
  "compileOnSave": false,
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "declaration": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@bsc/contracts": ["libs/shared-contracts/src/index.ts"],
      "@bsc/utils": ["libs/shared-utils/src/index.ts"],
      "@bsc/design-tokens": ["libs/shared-design-tokens/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
